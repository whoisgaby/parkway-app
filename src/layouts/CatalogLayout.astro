---
import "../styles/global.css";
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Catálogo · Parkway App</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div class="catalog-bar">
      <a href={import.meta.env.BASE_URL} class="back-link">← Parkway App</a>
      <span class="catalog-title">Catálogo de módulos</span>
      <span></span>
    </div>
    <slot />
  </body>
</html>

<style>
  .catalog-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 14px 32px;
    background: var(--color-text);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .back-link {
    color: var(--color-secondary);
    text-decoration: none;
    font-size: 0.88rem;
    letter-spacing: 0.04em;
  }

  .back-link:hover {
    color: #fff;
  }

  .catalog-title {
    font-family: var(--font-title);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--color-border);
  }
</style>
