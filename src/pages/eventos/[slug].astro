---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("eventos");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, image, date, location } = entry.data;

const DAYS_ES = ["Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"];
const MONTHS_ES = ["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
const dateLabel = `${DAYS_ES[date.getDay()]} ${date.getDate()} de ${MONTHS_ES[date.getMonth()]} de ${date.getFullYear()}`;
---

<BaseLayout title={`${title} · Parkway`} description={description}>
  <div class="detail-hero">
    <img src={image} alt={title} class="detail-image" />
    <div class="detail-hero-overlay">
      <div class="detail-hero-inner">
        <span class="detail-tag">Evento</span>
        <h1>{title}</h1>
        <p class="detail-meta">{dateLabel} · {location}</p>
      </div>
    </div>
  </div>

  <div class="detail-body">
    <div class="detail-content">
      <Content />
    </div>

    <aside class="detail-sidebar">
      <div class="sidebar-card">
        <h2>Detalles</h2>
        <div class="sidebar-row">
          <span class="sidebar-label">Fecha</span>
          <span>{dateLabel}</span>
        </div>
        <div class="sidebar-row">
          <span class="sidebar-label">Lugar</span>
          <span>{location}</span>
        </div>
      </div>

      <a href="/eventos" class="back-link">← Todos los eventos</a>
    </aside>
  </div>
</BaseLayout>

<style>
  .detail-hero {
    position: relative;
    height: 480px;
    overflow: hidden;
  }

  .detail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .detail-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 35, 20, 0.85) 0%, transparent 55%);
    display: flex;
    align-items: flex-end;
  }

  .detail-hero-inner {
    padding: 48px 64px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .detail-tag {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 999px;
    align-self: flex-start;
  }

  h1 {
    font-family: var(--font-title);
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: #fff;
    line-height: 1.1;
  }

  .detail-meta {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .detail-body {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 64px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 64px 48px;
  }

  .detail-content {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .detail-content :global(h2) {
    font-family: var(--font-title);
    font-size: 1.6rem;
    color: var(--color-primary);
    margin: 40px 0 16px;
  }

  .detail-content :global(h3) {
    font-family: var(--font-title);
    font-size: 1.25rem;
    color: var(--color-primary);
    margin: 28px 0 10px;
  }

  .detail-content :global(p) {
    margin-bottom: 18px;
  }

  .detail-content :global(ul),
  .detail-content :global(ol) {
    padding-left: 24px;
    margin-bottom: 18px;
  }

  .detail-content :global(li) {
    margin-bottom: 6px;
  }

  .detail-content :global(strong) {
    color: var(--color-primary);
    font-weight: 700;
  }

  .sidebar-card {
    background: var(--color-neutral);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 28px;
    margin-bottom: 24px;
  }

  .sidebar-card h2 {
    font-family: var(--font-title);
    font-size: 1rem;
    color: var(--color-primary);
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sidebar-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .sidebar-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
