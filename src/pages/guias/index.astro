---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSimple from "../../components/modules/HeroSimple.astro";

const articulos = await getCollection("articulos");
---

<BaseLayout
  title="Guías · Parkway"
  description="Artículos e historias sobre el Parkway: gastronomía, patrimonio y vida de barrio en la Avenida Chile, Bogotá."
>
  <HeroSimple
    eyebrow="Guías y artículos"
    title="Historias del Parkway"
    description="Gastronomía, arquitectura y vida de barrio. Todo lo que vale la pena conocer sobre la Avenida Chile."
  />

  <section class="guias-section">
    <div class="guias-list">
      {articulos.map((articulo) => (
        <a href={`/guias/${articulo.id.replace(/\.md$/, "")}`} class="guia-item">
          <div class="guia-image-wrap">
            <Image src={articulo.data.image} alt={articulo.data.title} />
          </div>
          <div class="guia-body">
            {articulo.data.author && (
              <p class="guia-author">{articulo.data.author}</p>
            )}
            <h2>{articulo.data.title}</h2>
            <p class="guia-desc">{articulo.data.description}</p>
            <span class="guia-link">Leer artículo →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .guias-section {
    padding: 72px 56px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .guias-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .guia-item {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 0;
    text-decoration: none;
    color: var(--color-text);
    border-top: 1px solid var(--color-border);
    transition: background 0.15s;
  }

  .guia-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .guia-item:hover {
    background: rgba(47, 74, 45, 0.03);
  }

  .guia-image-wrap {
    height: 200px;
    overflow: hidden;
  }

  .guia-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }

  .guia-item:hover .guia-image-wrap img {
    transform: scale(1.04);
  }

  .guia-body {
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  .guia-author {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .guia-body h2 {
    font-family: var(--font-title);
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    color: var(--color-primary);
    line-height: 1.15;
  }

  .guia-desc {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text);
    opacity: 0.7;
    max-width: 56ch;
  }

  .guia-link {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    text-transform: uppercase;
    margin-top: 4px;
  }
</style>
