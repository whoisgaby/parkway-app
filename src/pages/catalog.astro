---
import CatalogLayout from "../layouts/CatalogLayout.astro";
import HeroFullbleed from "../components/modules/HeroFullbleed.astro";
import HeroAsimetrico from "../components/modules/HeroAsimetrico.astro";
import HeroEditorial from "../components/modules/HeroEditorial.astro";
import IntroStrip from "../components/modules/IntroStrip.astro";
import Marquee from "../components/modules/Marquee.astro";
import EventsGrid from "../components/modules/EventsGrid.astro";
import CardsSection from "../components/modules/CardsSection.astro";
import AgendaSection from "../components/modules/AgendaSection.astro";
import SplitSection from "../components/modules/SplitSection.astro";
import PhotoCollage from "../components/modules/PhotoCollage.astro";
import StatsBlock from "../components/modules/StatsBlock.astro";
import RestaurantList from "../components/modules/RestaurantList.astro";
import NewsletterForm from "../components/modules/NewsletterForm.astro";
import CtaBand from "../components/modules/CtaBand.astro";

const modules = [
  {
    id: "hero-fullbleed",
    name: "HeroFullbleed",
    source: "P1",
    desc: "Hero de pantalla completa con imagen de fondo, overlay degradado y copy al pie.",
    done: true,
  },
  {
    id: "hero-asimetrico",
    name: "HeroAsimetrico",
    source: "P2",
    desc: "Hero con fondo verde oscuro, texto a la izquierda e imagen a la derecha. Incluye badge animado y bloque de estadísticas.",
    done: true,
  },
  {
    id: "hero-editorial",
    name: "HeroEditorial",
    source: "P3",
    desc: "Hero partido 50/50: texto con tipografía editorial a la izquierda, imagen + franja de datos a la derecha.",
    done: true,
  },
  {
    id: "intro-strip",
    name: "IntroStrip",
    source: "P1",
    desc: "Barra horizontal sobre fondo verde oscuro con ítems de datos clave (fechas, lugar, precio).",
    done: true,
  },
  {
    id: "marquee",
    name: "Marquee",
    source: "P2 / P3",
    desc: "Franja de texto animado en loop. Fondo terracota, texto en mayúsculas.",
    done: true,
  },
  {
    id: "events-grid",
    name: "EventsGrid",
    source: "P1",
    desc: "Grilla de eventos con tarjeta destacada (2 columnas de alto) y dos tarjetas secundarias.",
    done: true,
  },
  {
    id: "cards-section",
    name: "CardsSection",
    source: "P2",
    desc: "Sección de tres columnas con eyebrow, título, descripción y enlace. Fondo beige.",
    done: true,
  },
  {
    id: "agenda-section",
    name: "AgendaSection",
    source: "P3",
    desc: "Agenda con sidebar de pestañas por día y lista de eventos con hora, título y categoría.",
    done: true,
  },
  {
    id: "split-section",
    name: "SplitSection",
    source: "P1 / P2",
    desc: "Imagen a la izquierda, panel de contenido con fondo verde a la derecha. Eyebrow, título, texto y CTA.",
    done: true,
  },
  {
    id: "photo-collage",
    name: "PhotoCollage",
    source: "P3",
    desc: "Collage fotográfico tipo masonry con celdas de distintos tamaños y overlay hover.",
    done: true,
  },
  {
    id: "restaurant-list",
    name: "RestaurantList",
    source: "P3",
    desc: "Lista numerada de restaurantes con nombre, descripción y tag de categoría.",
    done: true,
  },
  {
    id: "stats-block",
    name: "StatsBlock",
    source: "P2",
    desc: "Bloque de métricas con número grande en serif y label en mayúsculas. Se usa dentro de otros módulos.",
    done: true,
  },
  {
    id: "newsletter-form",
    name: "NewsletterForm",
    source: "P2",
    desc: "Sección centrada con input de email y botón de suscripción. Fondo neutro.",
    done: true,
  },
  {
    id: "cta-band",
    name: "CtaBand",
    source: "P3",
    desc: "Banda horizontal verde oscuro con título tipográfico grande y dos botones de acción.",
    done: true,
  },
];

const doneCount = modules.filter((m) => m.done).length;
---

<CatalogLayout title="Catálogo">

  <!-- ÍNDICE -->
  <div class="index-section">
    <div class="index-header">
      <h1 class="index-title">Módulos</h1>
      <span class="index-count">{doneCount} de {modules.length} implementados</span>
    </div>
    <div class="index-grid">
      {modules.map((m) => (
        <div class:list={["index-item", { "index-item--pending": !m.done }]}>
          <div class="index-item-top">
            {m.done
              ? <a href={`#${m.id}`} class="index-name">{m.name}</a>
              : <span class="index-name">{m.name}</span>
            }
            <span class="index-source">{m.source}</span>
          </div>
          <p class="index-desc">{m.desc}</p>
          <span class:list={["index-status", m.done ? "index-status--done" : "index-status--pending"]}>
            {m.done ? "Implementado" : "Pendiente"}
          </span>
        </div>
      ))}
    </div>
  </div>

  <div class="divider"></div>

  <!-- MÓDULOS IMPLEMENTADOS -->

  <div class="module-block" id="hero-fullbleed">
    <div class="module-meta">
      <span class="module-name">HeroFullbleed</span>
      <span class="module-source">Propuesta 1</span>
      <span class="module-desc">Hero de pantalla completa con imagen de fondo, overlay degradado y copy al pie.</span>
    </div>
    <HeroFullbleed
      image="/images/web/parque.webp"
      eyebrow="Bogotá · La Soledad · Temporada 2025"
      title="Vino al"
      titleAccent="Parkway"
      description="Un festival que celebra el arte, el vino y la cultura del sector. Gastronomía, encuentros culturales y una atmósfera ideal para recorrer y disfrutar."
      primaryLabel="Ver eventos"
      primaryHref="/eventos"
      secondaryLabel="Cómo llegar"
      secondaryHref="#"
    />
  </div>

  <div class="module-block" id="hero-asimetrico">
    <div class="module-meta">
      <span class="module-name">HeroAsimetrico</span>
      <span class="module-source">Propuesta 2</span>
      <span class="module-desc">Hero con fondo verde oscuro, texto a la izquierda e imagen a la derecha. Incluye badge animado y bloque de estadísticas.</span>
    </div>
    <HeroAsimetrico
      image="/images/web/parque.webp"
      imageAlt="Parque Parkway"
      badge="15 – 17 agosto · Bogotá"
      title="Vino"
      titleItalic="al"
      titleAccent="Parkway"
      description="Festival cultural y gastronómico en el corazón del barrio. Arte, vino, y la mejor escena culinaria de la Avenida Chile."
      primaryLabel="Ver programa"
      primaryHref="/eventos"
      secondaryLabel="Cómo llegar"
      secondaryHref="#"
      stats={[
        { num: "30+", label: "Restaurantes" },
        { num: "3",   label: "Días de fest." },
        { num: "12",  label: "Eventos" },
      ]}
      imageBadgeTitle="Entrada libre"
      imageBadgeSubtitle="Todo el fin de semana"
    />
  </div>

  <div class="module-block" id="hero-editorial">
    <div class="module-meta">
      <span class="module-name">HeroEditorial</span>
      <span class="module-source">Propuesta 3</span>
      <span class="module-desc">Hero partido 50/50: texto con tipografía editorial a la izquierda, imagen + franja de datos a la derecha.</span>
    </div>
    <HeroEditorial
      image="/images/web/parque.webp"
      imageAlt="Parque Parkway"
      badge="Festival · Agosto 2025"
      title="Vino"
      titleItalic="al Park-way"
      metaItems={["15–17 agosto", "La Soledad, Bogotá", "Entrada libre"]}
      description="Un festival que celebra el arte, el vino y la cultura del sector. Gastronomía, encuentros culturales y una atmósfera ideal para recorrer y disfrutar."
      primaryLabel="Ver eventos"
      primaryHref="/eventos"
      secondaryLabel="Reservar"
      secondaryHref="#"
      stats={[
        { num: "30+",   label: "Restaurantes" },
        { num: "3 días", label: "De festival" },
      ]}
    />
  </div>

  <div class="module-block" id="intro-strip">
    <div class="module-meta">
      <span class="module-name">IntroStrip</span>
      <span class="module-source">Propuesta 1</span>
      <span class="module-desc">Barra horizontal sobre fondo verde oscuro con ítems de datos clave (fechas, lugar, precio).</span>
    </div>
    <IntroStrip
      items={["15 – 17 de agosto", "La Soledad, Bogotá", "Entrada libre", "Más de 30 restaurantes"]}
    />
  </div>

  <div class="module-block" id="marquee">
    <div class="module-meta">
      <span class="module-name">Marquee</span>
      <span class="module-source">Propuesta 2 / 3</span>
      <span class="module-desc">Franja de texto animado en loop. Fondo terracota, texto en mayúsculas.</span>
    </div>
    <Marquee
      items={["Festival Vino al Parkway", "15 al 17 de agosto", "Gastronomía", "Arte", "Cultura bogotana", "Avenida Chile", "Entrada libre"]}
      separator="✦"
      speed={22}
    />
  </div>

  <div class="module-block" id="events-grid">
    <div class="module-meta">
      <span class="module-name">EventsGrid</span>
      <span class="module-source">Propuesta 1</span>
      <span class="module-desc">Grilla de eventos con tarjeta destacada (2 columnas de alto) y dos tarjetas secundarias.</span>
    </div>
    <EventsGrid title="Próximos eventos" viewAllLabel="Ver todos →" viewAllHref="/eventos" />
  </div>

  <div class="module-block" id="cards-section">
    <div class="module-meta">
      <span class="module-name">CardsSection</span>
      <span class="module-source">Propuesta 2</span>
      <span class="module-desc">Sección de tres columnas con eyebrow, título, descripción y enlace. Fondo beige.</span>
    </div>
    <CardsSection
      eyebrow="Qué hacer"
      title="Experiencias que no te puedes perder"
      cards={[
        {
          image: "/images/web/restaurante.webp",
          imageAlt: "Gastronomía",
          category: "Gastronomía",
          title: "Ruta de restaurantes",
          description: "Recorre los mejores lugares del Parkway con menús especiales diseñados para el festival.",
          linkLabel: "Ver restaurantes →",
          linkHref: "#",
        },
        {
          image: "/images/web/calle.webp",
          imageAlt: "Recorrido patrimonial",
          category: "Cultura",
          title: "Recorrido patrimonial",
          description: "Descubre la historia y arquitectura del barrio con guías especializados del sector.",
          linkLabel: "Ver horarios →",
          linkHref: "#",
        },
        {
          image: "/images/web/oliveto.webp",
          imageAlt: "Cata de vinos",
          category: "Experiencia",
          title: "Cata de vinos en Oliveto",
          description: "Una noche especial con selección de vinos y maridaje en uno de los mejores del sector.",
          linkLabel: "Reservar →",
          linkHref: "#",
        },
      ]}
    />
  </div>

  <div class="module-block" id="agenda-section">
    <div class="module-meta">
      <span class="module-name">AgendaSection</span>
      <span class="module-source">Propuesta 3</span>
      <span class="module-desc">Agenda con sidebar de pestañas por día y lista de eventos con hora, título y categoría.</span>
    </div>
    <AgendaSection
      eyebrow="Programa"
      title="¿Qué hay este fin de semana?"
      description="Explora la agenda completa del festival y reserva tu lugar en los eventos con cupo limitado."
    />
  </div>

  <div class="module-block" id="split-section">
    <div class="module-meta">
      <span class="module-name">SplitSection</span>
      <span class="module-source">Propuesta 1 / 2</span>
      <span class="module-desc">Imagen a la izquierda, panel de contenido con fondo verde a la derecha. Eyebrow, título, texto y CTA.</span>
    </div>
    <SplitSection
      image="/images/web/calle.webp"
      imageAlt="Calle Parkway"
      eyebrow="El barrio"
      title="Un paseo que vale la pena"
      description="La Avenida Chile — conocida como el Parkway — es un corredor arbolado que desde hace décadas reúne lo mejor de la gastronomía, el arte y la vida de barrio bogotana."
      ctaLabel="Explorar el sector"
      ctaHref="#"
      ctaVariant="light"
    />
    <SplitSection
      image="/images/web/fachada.webp"
      imageAlt="Fachada del barrio"
      imageDim={true}
      eyebrow="El sector"
      title="La Avenida Chile te espera"
      description="El Parkway es el eje verde del barrio La Soledad. Un corredor peatonal con árboles centenarios, cafés, restaurantes y arte callejero que lo hacen único en Bogotá."
      ctaLabel="Explorar el mapa"
      ctaHref="#"
      ctaVariant="accent"
    />
  </div>

  <div class="module-block" id="photo-collage">
    <div class="module-meta">
      <span class="module-name">PhotoCollage</span>
      <span class="module-source">Propuesta 3</span>
      <span class="module-desc">Collage fotográfico tipo masonry con celdas de distintos tamaños y overlay hover.</span>
    </div>
    <PhotoCollage
      items={[
        { image: "/images/web/restaurante.webp",    imageAlt: "Restaurante",    label: "Gastronomía", tall: true },
        { image: "/images/web/parque-atardecer.webp", imageAlt: "Parque",       label: "El parque" },
        { image: "/images/web/oliveto.webp",         imageAlt: "Oliveto",       label: "Oliveto" },
        { image: "/images/web/calle.webp",           imageAlt: "La calle",      label: "La calle", wide: true },
      ]}
    />
  </div>

  <div class="module-block" id="stats-block">
    <div class="module-meta">
      <span class="module-name">StatsBlock</span>
      <span class="module-source">Propuesta 2</span>
      <span class="module-desc">Bloque de métricas con número grande en serif y label en mayúsculas. Se usa dentro de otros módulos.</span>
    </div>
    <StatsBlock
      theme="dark"
      stats={[
        { num: "30+", label: "Restaurantes" },
        { num: "3",   label: "Días de festival" },
        { num: "12",  label: "Eventos" },
        { num: "1km", label: "De recorrido" },
      ]}
    />
    <StatsBlock
      theme="light"
      stats={[
        { num: "30+", label: "Restaurantes" },
        { num: "3",   label: "Días de festival" },
        { num: "12",  label: "Eventos" },
        { num: "1km", label: "De recorrido" },
      ]}
    />
  </div>

  <div class="module-block" id="restaurant-list">
    <div class="module-meta">
      <span class="module-name">RestaurantList</span>
      <span class="module-source">Propuesta 3</span>
      <span class="module-desc">Lista numerada de restaurantes con nombre, descripción y tag de categoría.</span>
    </div>
    <RestaurantList
      eyebrow="Dónde comer"
      title="Restaurantes del Parkway"
      viewAllLabel="Ver todos"
      viewAllHref="/restaurantes"
    />
  </div>

  <div class="module-block" id="newsletter-form">
    <div class="module-meta">
      <span class="module-name">NewsletterForm</span>
      <span class="module-source">Propuesta 2</span>
      <span class="module-desc">Sección centrada con input de email y botón de suscripción. Fondo neutro.</span>
    </div>
    <NewsletterForm
      eyebrow="Mantente al día"
      title="Recibe el programa del festival"
      description="Entérate primero de eventos, reservas y novedades del Parkway."
      placeholder="tucorreo@email.com"
      buttonLabel="Suscribirme"
    />
  </div>

  <div class="module-block" id="cta-band">
    <div class="module-meta">
      <span class="module-name">CtaBand</span>
      <span class="module-source">Propuesta 3</span>
      <span class="module-desc">Banda horizontal verde oscuro con título tipográfico grande y dos botones de acción.</span>
    </div>
    <CtaBand
      title="Ven al"
      titleItalic="Parkway"
      titleSuffix="este agosto."
      primaryLabel="Ver programa completo"
      primaryHref="#"
      secondaryLabel="Cómo llegar"
      secondaryHref="#"
    />
  </div>

</CatalogLayout>

<style>
  /* ── ÍNDICE ── */
  .index-section {
    padding: 48px 48px 64px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .index-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 36px;
  }

  .index-title {
    font-family: var(--font-title);
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    color: var(--color-primary);
    font-weight: 500;
  }

  .index-count {
    font-size: 0.85rem;
    color: var(--color-text);
    opacity: 0.5;
    letter-spacing: 0.04em;
  }

  .index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .index-item {
    background: var(--color-neutral);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .index-item--pending {
    opacity: 0.55;
  }

  .index-item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .index-name {
    font-family: var(--font-title);
    font-size: 1rem;
    color: var(--color-primary);
    text-decoration: none;
  }

  a.index-name:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .index-source {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .index-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-text);
    opacity: 0.75;
    flex: 1;
  }

  .index-status {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .index-status--done {
    background: var(--color-secondary);
    color: var(--color-primary);
  }

  .index-status--pending {
    background: var(--color-border);
    color: var(--color-text);
  }

  /* ── SEPARADOR ── */
  .divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 48px 64px;
  }

  /* ── MÓDULOS ── */
  .module-block {
    margin-bottom: 80px;
    scroll-margin-top: 52px;
  }

  .module-meta {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 12px 32px;
    background: var(--color-neutral);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .module-name {
    font-family: var(--font-title);
    font-size: 1rem;
    color: var(--color-primary);
  }

  .module-source {
    font-size: 0.75rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .module-desc {
    font-size: 0.88rem;
    color: var(--color-text);
    opacity: 0.6;
  }
</style>
