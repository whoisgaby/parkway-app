---
import CatalogLayout from "../layouts/CatalogLayout.astro";
import HeroFullbleed from "../components/modules/HeroFullbleed.astro";
import HeroAsimetrico from "../components/modules/HeroAsimetrico.astro";
import HeroEditorial from "../components/modules/HeroEditorial.astro";
import IntroStrip from "../components/modules/IntroStrip.astro";
import Marquee from "../components/modules/Marquee.astro";

const modules = [
  {
    id: "hero-fullbleed",
    name: "HeroFullbleed",
    source: "P1",
    desc: "Hero de pantalla completa con imagen de fondo, overlay degradado y copy al pie.",
    done: true,
  },
  {
    id: "hero-asimetrico",
    name: "HeroAsimetrico",
    source: "P2",
    desc: "Hero con fondo verde oscuro, texto a la izquierda e imagen a la derecha. Incluye badge animado y bloque de estadísticas.",
    done: true,
  },
  {
    id: "hero-editorial",
    name: "HeroEditorial",
    source: "P3",
    desc: "Hero partido 50/50: texto con tipografía editorial a la izquierda, imagen + franja de datos a la derecha.",
    done: true,
  },
  {
    id: "intro-strip",
    name: "IntroStrip",
    source: "P1",
    desc: "Barra horizontal sobre fondo verde oscuro con ítems de datos clave (fechas, lugar, precio).",
    done: true,
  },
  {
    id: "marquee",
    name: "Marquee",
    source: "P2 / P3",
    desc: "Franja de texto animado en loop. Fondo terracota, texto en mayúsculas.",
    done: true,
  },
  {
    id: "events-grid",
    name: "EventsGrid",
    source: "P1",
    desc: "Grilla de eventos con tarjeta destacada (2 columnas de alto) y dos tarjetas secundarias.",
    done: false,
  },
  {
    id: "cards-section",
    name: "CardsSection",
    source: "P2",
    desc: "Sección de tres columnas con eyebrow, título, descripción y enlace. Fondo beige.",
    done: false,
  },
  {
    id: "agenda-section",
    name: "AgendaSection",
    source: "P3",
    desc: "Agenda con sidebar de pestañas por día y lista de eventos con hora, título y categoría.",
    done: false,
  },
  {
    id: "split-section",
    name: "SplitSection",
    source: "P1 / P2",
    desc: "Imagen a la izquierda, panel de contenido con fondo verde a la derecha. Eyebrow, título, texto y CTA.",
    done: false,
  },
  {
    id: "photo-collage",
    name: "PhotoCollage",
    source: "P3",
    desc: "Collage fotográfico tipo masonry con celdas de distintos tamaños y overlay hover.",
    done: false,
  },
  {
    id: "restaurant-list",
    name: "RestaurantList",
    source: "P3",
    desc: "Lista numerada de restaurantes con nombre, descripción y tag de categoría.",
    done: false,
  },
  {
    id: "stats-block",
    name: "StatsBlock",
    source: "P2",
    desc: "Bloque de métricas con número grande en serif y label en mayúsculas. Se usa dentro de otros módulos.",
    done: false,
  },
  {
    id: "newsletter-form",
    name: "NewsletterForm",
    source: "P2",
    desc: "Sección centrada con input de email y botón de suscripción. Fondo neutro.",
    done: false,
  },
  {
    id: "cta-band",
    name: "CtaBand",
    source: "P3",
    desc: "Banda horizontal verde oscuro con título tipográfico grande y dos botones de acción.",
    done: false,
  },
];

const doneCount = modules.filter((m) => m.done).length;
---

<CatalogLayout title="Catálogo">

  <!-- ÍNDICE -->
  <div class="index-section">
    <div class="index-header">
      <h1 class="index-title">Módulos</h1>
      <span class="index-count">{doneCount} de {modules.length} implementados</span>
    </div>
    <div class="index-grid">
      {modules.map((m) => (
        <div class:list={["index-item", { "index-item--pending": !m.done }]}>
          <div class="index-item-top">
            {m.done
              ? <a href={`#${m.id}`} class="index-name">{m.name}</a>
              : <span class="index-name">{m.name}</span>
            }
            <span class="index-source">{m.source}</span>
          </div>
          <p class="index-desc">{m.desc}</p>
          <span class:list={["index-status", m.done ? "index-status--done" : "index-status--pending"]}>
            {m.done ? "Implementado" : "Pendiente"}
          </span>
        </div>
      ))}
    </div>
  </div>

  <div class="divider"></div>

  <!-- MÓDULOS IMPLEMENTADOS -->

  <div class="module-block" id="hero-fullbleed">
    <div class="module-meta">
      <span class="module-name">HeroFullbleed</span>
      <span class="module-source">Propuesta 1</span>
      <span class="module-desc">Hero de pantalla completa con imagen de fondo, overlay degradado y copy al pie.</span>
    </div>
    <HeroFullbleed
      image="/images/web/parque.webp"
      eyebrow="Bogotá · La Soledad · Temporada 2025"
      title="Vino al"
      titleAccent="Parkway"
      description="Un festival que celebra el arte, el vino y la cultura del sector. Gastronomía, encuentros culturales y una atmósfera ideal para recorrer y disfrutar."
      primaryLabel="Ver eventos"
      primaryHref="/eventos"
      secondaryLabel="Cómo llegar"
      secondaryHref="#"
    />
  </div>

  <div class="module-block" id="hero-asimetrico">
    <div class="module-meta">
      <span class="module-name">HeroAsimetrico</span>
      <span class="module-source">Propuesta 2</span>
      <span class="module-desc">Hero con fondo verde oscuro, texto a la izquierda e imagen a la derecha. Incluye badge animado y bloque de estadísticas.</span>
    </div>
    <HeroAsimetrico
      image="/images/web/parque.webp"
      imageAlt="Parque Parkway"
      badge="15 – 17 agosto · Bogotá"
      title="Vino"
      titleItalic="al"
      titleAccent="Parkway"
      description="Festival cultural y gastronómico en el corazón del barrio. Arte, vino, y la mejor escena culinaria de la Avenida Chile."
      primaryLabel="Ver programa"
      primaryHref="/eventos"
      secondaryLabel="Cómo llegar"
      secondaryHref="#"
      stats={[
        { num: "30+", label: "Restaurantes" },
        { num: "3",   label: "Días de fest." },
        { num: "12",  label: "Eventos" },
      ]}
      imageBadgeTitle="Entrada libre"
      imageBadgeSubtitle="Todo el fin de semana"
    />
  </div>

  <div class="module-block" id="hero-editorial">
    <div class="module-meta">
      <span class="module-name">HeroEditorial</span>
      <span class="module-source">Propuesta 3</span>
      <span class="module-desc">Hero partido 50/50: texto con tipografía editorial a la izquierda, imagen + franja de datos a la derecha.</span>
    </div>
    <HeroEditorial
      image="/images/web/parque.webp"
      imageAlt="Parque Parkway"
      badge="Festival · Agosto 2025"
      title="Vino"
      titleItalic="al Park-way"
      metaItems={["15–17 agosto", "La Soledad, Bogotá", "Entrada libre"]}
      description="Un festival que celebra el arte, el vino y la cultura del sector. Gastronomía, encuentros culturales y una atmósfera ideal para recorrer y disfrutar."
      primaryLabel="Ver eventos"
      primaryHref="/eventos"
      secondaryLabel="Reservar"
      secondaryHref="#"
      stats={[
        { num: "30+",   label: "Restaurantes" },
        { num: "3 días", label: "De festival" },
      ]}
    />
  </div>

  <div class="module-block" id="intro-strip">
    <div class="module-meta">
      <span class="module-name">IntroStrip</span>
      <span class="module-source">Propuesta 1</span>
      <span class="module-desc">Barra horizontal sobre fondo verde oscuro con ítems de datos clave (fechas, lugar, precio).</span>
    </div>
    <IntroStrip
      items={["15 – 17 de agosto", "La Soledad, Bogotá", "Entrada libre", "Más de 30 restaurantes"]}
    />
  </div>

  <div class="module-block" id="marquee">
    <div class="module-meta">
      <span class="module-name">Marquee</span>
      <span class="module-source">Propuesta 2 / 3</span>
      <span class="module-desc">Franja de texto animado en loop. Fondo terracota, texto en mayúsculas.</span>
    </div>
    <Marquee
      items={["Festival Vino al Parkway", "15 al 17 de agosto", "Gastronomía", "Arte", "Cultura bogotana", "Avenida Chile", "Entrada libre"]}
      separator="✦"
      speed={22}
    />
  </div>

</CatalogLayout>

<style>
  /* ── ÍNDICE ── */
  .index-section {
    padding: 48px 48px 64px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .index-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 36px;
  }

  .index-title {
    font-family: var(--font-title);
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    color: var(--color-primary);
    font-weight: 500;
  }

  .index-count {
    font-size: 0.85rem;
    color: var(--color-text);
    opacity: 0.5;
    letter-spacing: 0.04em;
  }

  .index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .index-item {
    background: var(--color-neutral);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .index-item--pending {
    opacity: 0.55;
  }

  .index-item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .index-name {
    font-family: var(--font-title);
    font-size: 1rem;
    color: var(--color-primary);
    text-decoration: none;
  }

  a.index-name:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .index-source {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .index-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-text);
    opacity: 0.75;
    flex: 1;
  }

  .index-status {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .index-status--done {
    background: var(--color-secondary);
    color: var(--color-primary);
  }

  .index-status--pending {
    background: var(--color-border);
    color: var(--color-text);
  }

  /* ── SEPARADOR ── */
  .divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 48px 64px;
  }

  /* ── MÓDULOS ── */
  .module-block {
    margin-bottom: 80px;
    scroll-margin-top: 52px;
  }

  .module-meta {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 12px 32px;
    background: var(--color-neutral);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .module-name {
    font-family: var(--font-title);
    font-size: 1rem;
    color: var(--color-primary);
  }

  .module-source {
    font-size: 0.75rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .module-desc {
    font-size: 0.88rem;
    color: var(--color-text);
    opacity: 0.6;
  }
</style>
