---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSimple from "../components/modules/HeroSimple.astro";

const guias = [
  {
    category: "Moverse por el barrio",
    items: [
      {
        title: "Cómo llegar al Parkway",
        description:
          "TransMilenio, SITP y ciclovía: todas las opciones de transporte para llegar a la Avenida Chile desde cualquier punto de Bogotá.",
        tag: "Transporte",
        readTime: "3 min",
      },
      {
        title: "Recorrido a pie por la alameda",
        description:
          "Ruta sugerida de norte a sur por el corredor verde del Parkway, con paradas en los puntos de interés más importantes del trayecto.",
        tag: "Recorrido",
        readTime: "5 min",
      },
      {
        title: "Dónde parquear cerca del Parkway",
        description:
          "Parqueaderos disponibles, zonas de parqueo en vía y consejos para visitar el sector en carro sin complicaciones.",
        tag: "Transporte",
        readTime: "2 min",
      },
    ],
  },
  {
    category: "Gastronomía",
    items: [
      {
        title: "Guía de cafés de especialidad",
        description:
          "Un recorrido por los mejores cafés del sector: qué pedir, en qué horarios visitarlos y cuál es la propuesta de cada uno.",
        tag: "Cafés",
        readTime: "6 min",
      },
      {
        title: "Dónde desayunar en el Parkway",
        description:
          "Las mejores opciones para el desayuno en la Avenida Chile, desde arepas artesanales hasta brunch de fin de semana.",
        tag: "Desayunos",
        readTime: "4 min",
      },
      {
        title: "Restaurantes con terraza",
        description:
          "Selección de restaurantes y bares con espacio al aire libre para disfrutar el clima bogotano cuando el sol acompaña.",
        tag: "Ambiente",
        readTime: "4 min",
      },
    ],
  },
  {
    category: "Historia y cultura",
    items: [
      {
        title: "Historia de la Avenida Chile",
        description:
          "Del tranvía a la alameda peatonal: cómo la Avenida Chile se transformó en uno de los corredores urbanos más queridos de Bogotá.",
        tag: "Historia",
        readTime: "8 min",
      },
      {
        title: "Arquitectura moderna en el Parkway",
        description:
          "Guía visual de los edificios más representativos del movimiento moderno colombiano que bordean la Avenida Chile.",
        tag: "Arquitectura",
        readTime: "7 min",
      },
      {
        title: "Arte urbano y galerías del sector",
        description:
          "Murales, galerías independientes y estudios de artistas que hacen del Parkway uno de los focos creativos de la ciudad.",
        tag: "Arte",
        readTime: "5 min",
      },
    ],
  },
  {
    category: "Planes y experiencias",
    items: [
      {
        title: "Plan de tarde en el Parkway",
        description:
          "Itinerario para una tarde perfecta en el barrio: caminata por la alameda, visita a una galería, aperitivo y cena.",
        tag: "Plan",
        readTime: "4 min",
      },
      {
        title: "El Parkway con niños",
        description:
          "Parques, talleres y restaurantes amigables para visitar en familia. Todo lo que necesitas saber para un paseo sin estrés.",
        tag: "Familia",
        readTime: "5 min",
      },
      {
        title: "Mercados y compras de barrio",
        description:
          "Dónde encontrar los mejores mercados artesanales, tiendas de diseño y librerías de segunda mano en el sector.",
        tag: "Compras",
        readTime: "4 min",
      },
    ],
  },
];
---

<BaseLayout
  title="Guías · Parkway"
  description="Guías prácticas para descubrir el Parkway: transporte, gastronomía, historia, cultura y planes en la Avenida Chile."
>
  <HeroSimple
    eyebrow="Guías del barrio"
    title="Todo lo que necesitas saber"
    description="Recursos prácticos para sacarle el máximo partido al Parkway, ya sea que lo visites por primera vez o vivas a la vuelta de la esquina."
  />

  <div class="guias-container">
    {guias.map((group) => (
      <section class="guias-group">
        <h2 class="group-title">{group.category}</h2>
        <ul class="guias-list">
          {group.items.map((guia) => (
            <li class="guia-item">
              <div class="guia-meta">
                <span class="guia-tag">{guia.tag}</span>
                <span class="guia-time">{guia.readTime} de lectura</span>
              </div>
              <h3 class="guia-title">{guia.title}</h3>
              <p class="guia-desc">{guia.description}</p>
              <a href="#" class="guia-link">Leer guía →</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .guias-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 64px 48px 80px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .group-title {
    font-family: var(--font-title);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .guias-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .guia-item {
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    column-gap: 24px;
  }

  .guia-meta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .guia-tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    padding: 3px 10px;
    border-radius: 999px;
  }

  .guia-time {
    font-size: 0.78rem;
    color: var(--color-text);
    opacity: 0.45;
  }

  .guia-title {
    font-family: var(--font-title);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-primary);
    line-height: 1.3;
    grid-column: 1;
    align-self: start;
  }

  .guia-desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text);
    opacity: 0.7;
    grid-column: 1 / -1;
    margin-top: 8px;
  }

  .guia-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    letter-spacing: 0.02em;
    grid-column: 2;
    grid-row: 2;
    align-self: start;
    white-space: nowrap;
    padding-top: 3px;
  }

  .guia-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .guias-container {
      padding: 48px 24px 64px;
    }

    .guia-item {
      grid-template-columns: 1fr;
    }

    .guia-link {
      grid-column: 1;
      grid-row: auto;
      margin-top: 12px;
    }
  }
</style>
