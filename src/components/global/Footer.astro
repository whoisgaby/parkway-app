---
const year = new Date().getFullYear();

const columns = [
  {
    heading: "Explorar",
    links: [
      { label: "Eventos", href: "/eventos" },
      { label: "Restaurantes", href: "/restaurantes" },
      { label: "Lugares", href: "/lugares" },
    ],
  },
  {
    heading: "Contenido",
    links: [
      { label: "Guías", href: "/guias" },
      { label: "Sobre el Parkway", href: "/sobre" },
    ],
  },
  {
    heading: "Comunidad",
    links: [
      { label: "Instagram", href: "#" },
      { label: "Newsletter", href: "#" },
      { label: "Prensa", href: "#" },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-top">
    <div class="footer-brand">
      Parkway<br />App
      <small>Bogotá, Colombia</small>
    </div>
    <div class="footer-links">
      {columns.map((col) => (
        <div class="footer-col">
          <h4>{col.heading}</h4>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} Parkway App</span>
    <span>Hecho con amor en Bogotá</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-text);
    color: var(--color-bg);
    padding: 56px 64px 32px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 48px;
    gap: 48px;
  }

  .footer-brand {
    font-family: var(--font-title);
    font-size: 2.5rem;
    color: var(--color-secondary);
    line-height: 0.95;
    flex-shrink: 0;
  }

  .footer-brand small {
    display: block;
    font-size: 0.95rem;
    font-family: var(--font-body);
    color: var(--color-border);
    margin-top: 8px;
    letter-spacing: 0.02em;
  }

  .footer-links {
    display: flex;
    gap: 64px;
  }

  .footer-col h4 {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-border);
    margin-bottom: 16px;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col ul a {
    text-decoration: none;
    color: var(--color-bg);
    font-size: 0.95rem;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  .footer-col ul a:hover {
    opacity: 1;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 24px;
    font-size: 0.82rem;
    opacity: 0.5;
    display: flex;
    justify-content: space-between;
  }

  @media (max-width: 720px) {
    .footer {
      padding: 40px 24px 24px;
    }

    .footer-top {
      flex-direction: column;
    }

    .footer-links {
      gap: 32px;
      flex-wrap: wrap;
    }
  }
</style>
