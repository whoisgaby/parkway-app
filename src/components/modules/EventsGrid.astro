---
interface Event {
  image: string;
  imageAlt?: string;
  tag?: string;
  title: string;
  description?: string;
  meta?: string[];
  featured?: boolean;
}

interface Props {
  title?: string;
  viewAllLabel?: string;
  viewAllHref?: string;
  events: Event[];
}

const {
  title = "Próximos eventos",
  viewAllLabel = "Ver todos →",
  viewAllHref = "#",
  events = [],
} = Astro.props;

const [featured, ...rest] = events;
---

<section class="events-section">
  <div class="section-header">
    <h2>{title}</h2>
    <a href={viewAllHref}>{viewAllLabel}</a>
  </div>

  <div class="events-grid">
    {featured && (
      <div class="event-card featured">
        <img src={featured.image} alt={featured.imageAlt ?? ""} />
        <div class="event-body">
          {featured.tag && <span class="event-tag">{featured.tag}</span>}
          <h3>{featured.title}</h3>
          {featured.description && <p>{featured.description}</p>}
          {featured.meta && featured.meta.length > 0 && (
            <div class="event-meta">
              {featured.meta.map((m) => <span>{m}</span>)}
            </div>
          )}
        </div>
      </div>
    )}

    {rest.map((event) => (
      <div class="event-card">
        <img src={event.image} alt={event.imageAlt ?? ""} />
        <div class="event-body">
          {event.tag && <span class="event-tag">{event.tag}</span>}
          <h3>{event.title}</h3>
          {event.description && <p>{event.description}</p>}
          {event.meta && event.meta.length > 0 && (
            <div class="event-meta">
              {event.meta.map((m) => <span>{m}</span>)}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .events-section {
    padding: 80px 64px;
    background: var(--color-bg);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 48px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 20px;
  }

  .section-header h2 {
    font-family: var(--font-title);
    font-size: clamp(2rem, 3vw, 3rem);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .section-header a {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .events-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 24px;
  }

  .event-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(47, 74, 45, 0.07);
  }

  .event-card.featured {
    grid-row: span 2;
  }

  .event-card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .event-card.featured img {
    height: 380px;
  }

  .event-body {
    padding: 24px;
  }

  .event-tag {
    display: inline-block;
    background: var(--color-secondary);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .event-body h3 {
    font-family: var(--font-title);
    font-size: 1.45rem;
    color: var(--color-primary);
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .event-card.featured .event-body h3 {
    font-size: 2rem;
  }

  .event-body p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
    opacity: 0.85;
    margin-bottom: 20px;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
