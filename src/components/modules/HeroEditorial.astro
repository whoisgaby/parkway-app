---
interface Stat {
  num: string;
  label: string;
}

interface Props {
  badge?: string;
  title: string;
  titleItalic?: string;
  metaItems?: string[];
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  image: string;
  imageAlt?: string;
  stats?: Stat[];
}

const {
  badge = "Festival · Agosto 2025",
  title,
  titleItalic,
  metaItems = [],
  description,
  primaryLabel = "Ver eventos",
  primaryHref = "#",
  secondaryLabel = "Reservar",
  secondaryHref = "#",
  image,
  imageAlt = "",
  stats = [],
} = Astro.props;
---

<section class="hero">
  <div class="hero-left">
    {badge && (
      <span class="tag-pill">{badge}</span>
    )}

    <h1>
      {title}{titleItalic && <><br /><span class="serif-italic">{titleItalic}</span></>}
    </h1>

    {metaItems.length > 0 && (
      <div class="hero-meta-row">
        {metaItems.map((item, i) => (
          <>
            {i > 0 && <div class="hero-meta-sep" />}
            <span class="hero-meta-item">{item}</span>
          </>
        ))}
      </div>
    )}

    {description && <p>{description}</p>}

    <div class="hero-btns">
      <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>
      <a href={secondaryHref} class="btn btn-secondary">{secondaryLabel}</a>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-main-photo">
      <img src={image} alt={imageAlt} />
    </div>
    {stats.length > 0 && (
      <div class="hero-bottom-strip">
        {stats.map((s) => (
          <div class="strip-cell">
            <div class="num">{s.num}</div>
            <div class="lbl">{s.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - 52px);
  }

  /* ── LEFT ── */
  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 64px 56px 80px;
    border-right: 1px solid var(--color-border);
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-secondary);
    color: var(--color-primary);
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    width: fit-content;
    margin-bottom: 36px;
  }

  .tag-pill::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  h1 {
    font-family: var(--font-title);
    font-size: clamp(4rem, 7vw, 9rem);
    color: var(--color-primary);
    line-height: 0.88;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-bottom: 36px;
  }

  .serif-italic {
    font-style: italic;
    color: var(--color-accent);
    text-transform: none;
  }

  .hero-meta-row {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 32px;
  }

  .hero-meta-item {
    font-size: 0.85rem;
    color: var(--color-text);
    opacity: 0.65;
    letter-spacing: 0.05em;
  }

  .hero-meta-sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-border);
    flex-shrink: 0;
  }

  .hero-left p {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--color-text);
    max-width: 46ch;
    opacity: 0.8;
    margin-bottom: 44px;
  }

  .hero-btns {
    display: flex;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 32px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
  }

  /* ── RIGHT ── */
  .hero-right {
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .hero-main-photo {
    overflow: hidden;
  }

  .hero-main-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  .hero-bottom-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    border-top: 1px solid var(--color-border);
  }

  .strip-cell {
    padding: 24px 28px;
    border-right: 1px solid var(--color-border);
  }

  .strip-cell:last-child {
    border-right: none;
  }

  .strip-cell .num {
    font-family: var(--font-title);
    font-size: 2.2rem;
    color: var(--color-primary);
    line-height: 1;
  }

  .strip-cell .lbl {
    font-size: 0.8rem;
    color: var(--color-text);
    opacity: 0.6;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 4px;
  }
</style>
