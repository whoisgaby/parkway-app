---
interface Props {
  title: string;
  titleItalic?: string;
  titleSuffix?: string;
  primaryLabel: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  titleItalic,
  titleSuffix,
  primaryLabel,
  primaryHref = "#",
  secondaryLabel,
  secondaryHref = "#",
} = Astro.props;
---

<div class="cta-band">
  <h2>
    {title}
    {titleItalic && <><br /><em>{titleItalic}</em></>}
    {titleSuffix && <><br />{titleSuffix}</>}
  </h2>

  <div class="cta-actions">
    <a href={primaryHref} class="btn btn-white">{primaryLabel}</a>
    {secondaryLabel && (
      <a href={secondaryHref} class="btn btn-ghost">{secondaryLabel}</a>
    )}
  </div>
</div>

<style>
  .cta-band {
    background: var(--color-primary);
    padding: 88px 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  h2 {
    font-family: var(--font-title);
    font-size: clamp(2.5rem, 4vw, 5rem);
    color: #fff;
    line-height: 0.95;
  }

  h2 em {
    font-style: italic;
    color: var(--color-secondary);
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-shrink: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 32px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .btn-white {
    background: #fff;
    color: var(--color-primary);
  }

  .btn-ghost {
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    color: #fff;
    transition: border-color 0.2s;
  }

  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 720px) {
    .cta-band {
      flex-direction: column;
      align-items: flex-start;
      padding: 56px 24px;
      gap: 32px;
    }
  }
</style>
