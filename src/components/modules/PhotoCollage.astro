---
interface CollageItem {
  image: string;
  imageAlt?: string;
  label?: string;
  tall?: boolean;
  wide?: boolean;
}

interface Props {
  items: CollageItem[];
}

const { items = [] } = Astro.props;
---

<div class="collage">
  {items.map((item) => (
    <div class:list={["collage-cell", { tall: item.tall, wide: item.wide }]}>
      <img src={item.image} alt={item.imageAlt ?? ""} />
      {item.label && (
        <div class="collage-overlay">
          <span>{item.label}</span>
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .collage {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    grid-template-rows: 300px 300px;
    gap: 4px;
  }

  .collage-cell {
    overflow: hidden;
    position: relative;
  }

  .collage-cell.tall {
    grid-row: span 2;
  }

  .collage-cell.wide {
    grid-column: span 2;
  }

  .collage-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .collage-cell:hover img {
    transform: scale(1.04);
  }

  .collage-overlay {
    position: absolute;
    inset: 0;
    background: rgba(47, 74, 45, 0);
    transition: background 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collage-overlay span {
    color: #fff;
    font-family: var(--font-title);
    font-size: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .collage-cell:hover .collage-overlay {
    background: rgba(47, 74, 45, 0.45);
  }

  .collage-cell:hover .collage-overlay span {
    opacity: 1;
  }
</style>
