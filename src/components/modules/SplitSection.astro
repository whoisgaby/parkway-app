---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  imageAlt?: string;
  imageDim?: boolean;
  eyebrow?: string;
  title: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaVariant?: "light" | "accent";
  imagePosition?: "left" | "right";
}

const {
  image,
  imageAlt = "",
  imageDim = false,
  eyebrow,
  title,
  description,
  ctaLabel,
  ctaHref = "#",
  ctaVariant = "light",
  imagePosition = "left",
} = Astro.props;
---

<div class:list={["split", { "split--reversed": imagePosition === "right" }]}>
  <div class="split-img">
    <Image src={image} alt={imageAlt} class:list={{ dimmed: imageDim }} />
  </div>

  <div class="split-content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {description && <p class="desc">{description}</p>}
    {ctaLabel && (
      <a href={ctaHref} class:list={["btn", ctaVariant === "accent" ? "btn-accent" : "btn-light"]}>
        {ctaLabel}
      </a>
    )}
  </div>
</div>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .split--reversed {
    direction: rtl;
  }

  .split--reversed > * {
    direction: ltr;
  }

  .split-img {
    overflow: hidden;
    min-height: 500px;
  }

  .split-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .split-img img.dimmed {
    filter: brightness(0.8) saturate(0.7);
  }

  .split-content {
    background: var(--color-primary);
    color: var(--color-secondary);
    padding: 80px 64px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 20px;
  }

  h2 {
    font-family: var(--font-title);
    font-size: clamp(2.2rem, 3.5vw, 4rem);
    color: #fff;
    margin-bottom: 28px;
    line-height: 1.05;
  }

  .desc {
    font-size: 1.05rem;
    line-height: 1.75;
    opacity: 0.85;
    margin-bottom: 40px;
    max-width: 42ch;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    align-self: flex-start;
  }

  .btn-light {
    background: #fff;
    color: var(--color-primary);
  }

  .btn-accent {
    background: var(--color-accent);
    color: #fff;
  }

  @media (max-width: 720px) {
    .split {
      grid-template-columns: 1fr;
      direction: ltr;
    }

    .split--reversed > * {
      direction: ltr;
    }

    .split-img {
      min-height: 260px;
    }

    .split-content {
      padding: 48px 24px;
    }
  }
</style>
